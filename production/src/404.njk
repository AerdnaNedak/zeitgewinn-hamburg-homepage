---
permalink: /404.html
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>Weiterleitung · {{ site.name }}</title>
<script>
// Alte WordPress-Adressen, die es nicht mehr gibt, landen hier.
// Kategorien führen zum passenden Thema im Blog, Blog-Unterseiten zum Blog, alles andere zur Startseite.
(function () {
  var kategorien = {{ kategorien | kategorieMap | safe }};
  var pfad = location.pathname;
  var basis = '/';
  if (/\.github\.io$/.test(location.hostname)) {
    var erstes = pfad.split('/')[1];
    if (erstes) { basis = '/' + erstes + '/'; pfad = pfad.slice(basis.length - 1); }
  }
  var ziel = '';
  var m = pfad.match(/^\/category\/(?:[^?#]*\/)?([^/?#]+)\/?$/);
  if (m && kategorien[m[1]]) ziel = 'blog/?thema=' + encodeURIComponent(kategorien[m[1]]);
  else if (/^\/(blog|category|tag|author|page|feed|\d{4})(\/|$)/.test(pfad)) ziel = 'blog/';
  location.replace(basis + ziel);
})();
</script>
</head>
<body style="font-family:system-ui,sans-serif;padding:40px">
<p>Diese Seite gibt es nicht mehr. Sie werden zur <a href="/">Startseite</a> weitergeleitet.</p>
</body>
</html>
